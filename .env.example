# ==========================================
# AkashOS Environment Configuration
# ==========================================

# Server-side Gemini AI API Key
GEMINI_API_KEY=

# Internal Server Vault Secret (AES-256-GCM derivation)
SERVER_VAULT_SECRET=

# Public App Base URL for OAuth Callbacks (e.g., https://your-domain.run.app)
APP_URL=http://localhost:3000

# Google OAuth (YouTube Data API publishing integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Client Configuration (Optional overrides)
FIREBASE_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
